set_property LOC BUFHCE_X0Y0 [get_cells memory_interface/mig/u_mig_interface_mig/u_ddr3_infrastructure/u_bufh_pll_clk3]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y26 [get_ports CLK100MHZ]

# Clock net "memory_interface/mig/u_mig_interface_mig/u_ddr3_infrastructure/CLK" driven by instance "memory_interface/mig/u_mig_interface_mig/u_ddr3_infrastructure/u_bufg_clkdiv0" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_memory_interface/mig/u_mig_interface_mig/u_ddr3_infrastructure/CLK}
add_cells_to_pblock [get_pblocks  {CLKAG_memory_interface/mig/u_mig_interface_mig/u_ddr3_infrastructure/CLK}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=memory_interface/mig/u_mig_interface_mig/u_ddr3_infrastructure/gen_mmcm.mmcm_i} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="memory_interface/mig/u_mig_interface_mig/u_ddr3_infrastructure/CLK"}]]]
resize_pblock [get_pblocks {CLKAG_memory_interface/mig/u_mig_interface_mig/u_ddr3_infrastructure/CLK}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "clock_wizzard/inst/out_200mhz" driven by instance "clock_wizzard/inst/clkout2_buf" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_clock_wizzard/inst/out_200mhz}
add_cells_to_pblock [get_pblocks  {CLKAG_clock_wizzard/inst/out_200mhz}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clock_wizzard/inst/out_200mhz"}]]]
resize_pblock [get_pblocks {CLKAG_clock_wizzard/inst/out_200mhz}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup
